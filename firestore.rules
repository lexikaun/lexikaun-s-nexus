rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity validation helpers
    function isValidGoal(data, userId) {
      return data.id is string && isValidId(data.id) &&
        data.userId == userId &&
        (!('space' in data) || data.space in ['personal', 'professional']) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 300 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 3000)) &&
        (!('deadline' in data) || (data.deadline is string && data.deadline.size() <= 32)) &&
        (!('date' in data) || (data.date is string && data.date.size() <= 32)) &&
        data.priority in ['low', 'medium', 'high', 'critical'] &&
        data.status in ['active', 'completed', 'archived'] &&
        (!('createdAt' in data) || data.createdAt is number) &&
        (!('updatedAt' in data) || data.updatedAt is number);
    }

    function isValidTask(data, userId) {
      return data.id is string && isValidId(data.id) &&
        data.userId == userId &&
        (!('space' in data) || data.space in ['personal', 'professional']) &&
        (!('goalId' in data) || data.goalId == null || (data.goalId is string && data.goalId.size() <= 128)) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 300 &&
        (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 3000)) &&
        data.date is string && data.date.size() <= 32 &&
        data.startTime is string && data.startTime.size() <= 16 &&
        data.endTime is string && data.endTime.size() <= 16 &&
        (!('duration' in data) || data.duration is number) &&
        (!('durationMinutes' in data) || data.durationMinutes is number) &&
        data.priority in ['low', 'medium', 'high', 'critical'] &&
        data.status in ['planned', 'in_progress', 'completed', 'skipped', 'rescheduled'] &&
        (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 3000)) &&
        (!('recurrence' in data) || data.recurrence is map || data.recurrence in ['none', 'daily', 'weekdays', 'weekly', 'custom', 'monthly']) &&
        (!('recurrenceRule' in data) || data.recurrenceRule == null || (data.recurrenceRule is string && data.recurrenceRule.size() <= 200)) &&
        (!('associatedBeatId' in data) || data.associatedBeatId == null || (data.associatedBeatId is string && data.associatedBeatId.size() <= 128)) &&
        (!('completedAt' in data) || data.completedAt is number) &&
        (!('createdAt' in data) || data.createdAt is number) &&
        (!('updatedAt' in data) || data.updatedAt is number);
    }

    function isValidHabit(data, userId) {
      return data.id is string && isValidId(data.id) &&
        data.userId == userId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
        data.frequency is string &&
        (!('preferredTime' in data) || (data.preferredTime is string && data.preferredTime.size() <= 32)) &&
        (!('completionHistory' in data) || data.completionHistory is map) &&
        (!('streak' in data) || data.streak is number) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 3000)) &&
        (!('createdAt' in data) || data.createdAt is number) &&
        (!('updatedAt' in data) || data.updatedAt is number);
    }

    function isValidBeat(data, userId) {
      return data.id is string && isValidId(data.id) &&
        data.userId == userId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.audioUrl is string && data.audioUrl.size() <= 2048 &&
        (!('audioBlobId' in data) || (data.audioBlobId is string && data.audioBlobId.size() <= 256)) &&
        data.duration is number &&
        data.bpm is number &&
        data.key is string && data.key.size() <= 32 &&
        data.genre is string && data.genre.size() <= 64 &&
        data.tags is list && data.tags.size() <= 50 &&
        data.status in ['wip', 'finished', 'released', 'archived'] &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 4000)) &&
        (!('coverUrl' in data) || (data.coverUrl is string && data.coverUrl.size() <= 2048)) &&
        (!('color' in data) || (data.color is string && data.color.size() <= 32)) &&
        (!('isFavorite' in data) || data.isFavorite is bool) &&
        (!('fileFormat' in data) || (data.fileFormat is string && data.fileFormat.size() <= 32)) &&
        (!('fileSize' in data) || data.fileSize is number) &&
        data.createdAt is number &&
        data.uploadedAt is number;
    }

    function isValidPlaylist(data, userId) {
      return data.id is string && isValidId(data.id) &&
        data.userId == userId &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
        data.beatIds is list && data.beatIds.size() <= 200 &&
        data.createdAt is number;
    }

    function isValidMusicSession(data, userId) {
      return data.id is string && isValidId(data.id) &&
        data.userId == userId &&
        (!('beatId' in data) || (data.beatId is string && data.beatId.size() <= 128)) &&
        (!('beatTitle' in data) || (data.beatTitle is string && data.beatTitle.size() <= 200)) &&
        data.startTime is number &&
        (!('endTime' in data) || data.endTime is number) &&
        data.durationSeconds is number &&
        data.notes is string && data.notes.size() <= 5000 &&
        data.createdAt is number;
    }

    function isValidDailyReview(data, userId) {
      return data.id is string && isValidId(data.id) &&
        data.userId == userId &&
        data.date is string && data.date.size() <= 32 &&
        data.goalsCompleted is number &&
        data.totalGoals is number &&
        data.tasksCompleted is number &&
        data.tasksMissed is number &&
        data.tasksRescheduled is number &&
        data.totalPlannedMinutes is number &&
        data.totalCompletedMinutes is number &&
        data.completionRate is number &&
        data.whatWentWell is string && data.whatWentWell.size() <= 3000 &&
        data.whatToImprove is string && data.whatToImprove.size() <= 3000 &&
        (!('moodRating' in data) || data.moodRating is number) &&
        data.createdAt is number;
    }

    // Health check endpoint
    match /test/{docId} {
      allow read: if isSignedIn() && isValidId(docId);
    }

    // Authenticated user data subcollections
    match /users/{userId} {
      allow read: if isOwner(userId);

      // Goals subcollection
      match /goals/{goalId} {
        allow get: if isOwner(userId) && isValidId(goalId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(goalId) && isValidGoal(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(goalId) && isValidGoal(incoming(), userId) &&
          incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(goalId);
      }

      // Tasks subcollection
      match /tasks/{taskId} {
        allow get: if isOwner(userId) && isValidId(taskId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(taskId) && isValidTask(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(taskId) && isValidTask(incoming(), userId) &&
          incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      // Habits subcollection
      match /habits/{habitId} {
        allow get: if isOwner(userId) && isValidId(habitId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(habitId) && isValidHabit(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(habitId) && isValidHabit(incoming(), userId) &&
          incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(habitId);
      }

      // Beats subcollection
      match /beats/{beatId} {
        allow get: if isOwner(userId) && isValidId(beatId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(beatId) && isValidBeat(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(beatId) && isValidBeat(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(beatId);
      }

      // Playlists subcollection
      match /playlists/{playlistId} {
        allow get: if isOwner(userId) && isValidId(playlistId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(playlistId) && isValidPlaylist(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(playlistId) && isValidPlaylist(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(playlistId);
      }

      // Music Sessions subcollection
      match /musicSessions/{sessionId} {
        allow get: if isOwner(userId) && isValidId(sessionId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(sessionId) && isValidMusicSession(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(sessionId) && isValidMusicSession(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(sessionId);
      }

      // Daily Reviews subcollection
      match /dailyReviews/{reviewId} {
        allow get: if isOwner(userId) && isValidId(reviewId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(reviewId) && isValidDailyReview(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(reviewId) && isValidDailyReview(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(reviewId);
      }
    }
  }
}
